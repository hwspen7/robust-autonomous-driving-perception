* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Scientific tables are checksum-addressed artifacts. Preserve their exact
# bytes instead of normalizing line endings during checkout or commit.
*.csv -text
*.tsv -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.npy binary
*.npz binary
*.pt binary
*.pth binary
